PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/historical_doc_db?schema=public
JWT_SECRET=your_jwt_secret_key_placeholder
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

STORAGE_PROVIDER=mock
STORAGE_BUCKET_NAME=historical-doc-archive
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your_storage_access_key_placeholder
STORAGE_SECRET_KEY=your_storage_secret_key_placeholder

PAYMENT_GATEWAY=razorpay
PAYMENT_KEY_ID=your_razorpay_key_id_here
PAYMENT_KEY_SECRET=your_razorpay_key_secret_here
PAYMENT_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
